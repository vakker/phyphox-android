precision="0"><input>vidIso</input></value></view><view label="Accelerometer"><graph label="Acceleration X" timeOnX="true" labelX="t (s)" labelY="a (m/s²)" partialUpdate="true"><input axis="x">acc_time</input><input axis="y">accX</input></graph><graph label="Acceleration Y" timeOnX="true" labelX="t (s)" labelY="a (m/s²)" partialUpdate="true"><input axis="x">acc_time</input><input axis="y">accY</input></graph><graph label="Acceleration Z" timeOnX="true" labelX="t (s)" labelY="a (m/s²)" partialUpdate="true"><input axis="x">acc_time</input><input axis="y">accZ</input></graph></view><view label="Gyroscope"><graph label="Gyroscope X" timeOnX="true" labelX="t (s)" labelY="w (rad/s)" partialUpdate="true"><input axis="x">gyr_time</input><input axis="y">gyrX</input></graph><graph label="Gyroscope Y" timeOnX="true" labelX="t (s)" labelY="w (rad/s)" partialUpdate="true"><input axis="x">gyr_time</input><input axis="y">gyrY</input></graph><graph label="Gyroscope Z" timeOnX="true" labelX="t (s)" labelY="w (rad/s)" partialUpdate="true"><input axis="x">gyr_time</input><input axis="y">gyrZ</input></graph></view><view label="Magnetometer"><graph label="Magnetic field X" timeOnX="true" labelX="t (s)" labelY="B (µT)" partialUpdate="true"><input axis="x">mag_time</input><input axis="y">magX</input></graph><graph label="Magnetic field Y" timeOnX="true" labelX="t (s)" labelY="B (µT)" partialUpdate="true"><input axis="x">mag_time</input><input axis="y">magY</input></graph><graph label="Magnetic field Z" timeOnX="true" labelX="t (s)" labelY="B (µT)" partialUpdate="true"><input axis="x">mag_time</input><input axis="y">magZ</input></graph></view><view label="Pressure"><graph label="Pressure" timeOnX="true" labelX="t (s)" labelY="P (hPa)" partialUpdate="true"><input axis="x">pressure_time</input><input axis="y">pressure</input></graph></view><view label="Location"><graph label="Latitude" timeOnX="true" labelX="t (s)" labelY="Latitude (°)" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">locLat</input></graph><graph label="Longitude" timeOnX="true" labelX="t (s)" labelY="Longitude (°)" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">locLon</input></graph><graph label="Height" timeOnX="true" labelX="t (s)" labelY="z (m)" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">locZ</input></graph><graph label="Velocity" timeOnX="true" labelX="t (s)" labelY="v (m/s)" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">locV</input></graph><graph label="Direction" timeOnX="true" labelX="t (s)" labelY="heading (°)" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">locDir</input></graph><value label="Horizontal Accuracy" size="1" precision="1" unit="m"><input>locAccuracy</input></value><value label="Vertical Accuracy" size="1" precision="1" unit="m"><input>locZAccuracy</input></value><value label="Satellites" size="1" precision="0"><input>locSatellites</input></value><value label="Status" size="1" precision="0"><input>locStatus</input><map max="-1">GPS disabled</map><map max="0">Waiting for signal</map><map max="1">Active</map></value></view><view label="GNSS satellites"><graph label="C/N0 per tracked signal" timeOnX="true" labelX="t (s)" labelY="C/N0 (dB-Hz)" partialUpdate="true" style="dots"><input axis="x">svT</input><input axis="y">svCn0</input></graph><graph label="Satellites (in view, used in the fix)" timeOnX="true" labelX="t (s)" labelY="Satellites" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">satellitesInView</input><input axis="x">loc_time</input><input axis="y">satellitesUsed</input></graph><graph label="Signals (in view, used in the fix)" timeOnX="true" labelX="t (s)" labelY="Signals" partialUpdate="true"><input axis="x">loc_time</input><input axis="y">signalsInView</input><input axis="x">loc_time</input><input axis="y">signalsUsed</input></graph><value label="Time to first fix" size="1" precision="1" unit="s"><input>ttff</input></value></view><view label="GNSS NMEA"><graph label="Dilution of precision (PDOP, HDOP, VDOP)" timeOnX="true" labelX="t (s)" labelY="DOP" partialUpdate="true" style="dots"><input axis="x">gsaT</input><input axis="y">gsaPdop</input><input axis="x">gsaT</input><input axis="y">gsaHdop</input><input axis="x">gsaT</input><input axis="y">gsaVdop</input></graph><graph label="Fix quality" timeOnX="true" labelX="t (s)" labelY="Quality" partialUpdate="true" style="dots"><input axis="x">ggaT</input><input axis="y">ggaQuality</input></graph></view><view label="GNSS raw"><value label="Raw measurements"><input>measStatus</input><map max="0">not supported</map><map min="1" max="1">ready</map><map min="2" max="2">location disabled</map><map min="3">not allowed</map></value><graph label="C/N0 per signal" timeOnX="true" labelX="t (s)" labelY="C/N0 (dB-Hz)" partialUpdate="true" style="dots"><input axis="x">measT</input><input axis="y">measCn0</input></graph><graph label="Receiver clock drift" timeOnX="true" labelX="t (s)" labelY="Drift (ns/s)" partialUpdate="true"><input axis="x">clockT</input><input axis="y">clockDrift</input></graph></view></views><export><set name="Accelerometer"><data name="Time (s)">acc_time</data><data name="Acceleration x (m/s^2)">accX</data><data name="Acceleration y (m/s^2)">accY</data><data name="Acceleration z (m/s^2)">accZ</data></set><set name="Gyroscope"><data name="Time (s)">gyr_time</data><data name="Gyroscope x (rad/s)">gyrX</data><data name="Gyroscope y (rad/s)">gyrY</data><data name="Gyroscope z (rad/s)">gyrZ</data></set><set name="Magnetometer"><data name="Time (s)">mag_time</data><data name="Magnetic field x (µT)">magX</data><data name="Magnetic field y (µT)">magY</data><data name="Magnetic field z (µT)">magZ</data></set><set name="Pressure"><data name="Time (s)">pressure_time</data><data name="Pressure (hPa)">pressure</data></set><set name="Location"><data name="Time (s)">loc_time</data><data name="Latitude (°)">locLat</data><data name="Longitude (°)">loc